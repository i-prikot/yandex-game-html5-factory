{
  "name": "yandex-games-ai-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:factory": "npm run build",
    "cli": "tsx src/cli/index.ts",
    "start:cli": "node dist/cli/index.js",
    "test": "vitest run --maxWorkers=1",
    "test:unit": "vitest run tests --exclude tests/acceptance/** --maxWorkers=2",
    "test:acceptance": "vitest run tests/acceptance --testTimeout=120000 --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "archiver": "^7.0.1",
    "dotenv": "^17.2.1",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.7.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.2.1",
    "@types/pngjs": "^6.0.5",
    "@vitest/coverage-v8": "^3.2.7",
    "fflate": "^0.8.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
