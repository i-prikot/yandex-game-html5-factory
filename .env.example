GOOGLE_API_KEY=
XAI_API_KEY=
TRIPO3D_API_KEY=

# Optional non-interactive authentication for the host agents. The factory can
# also use credentials persisted by the CLI in the Docker config volumes.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Codex-only CRS proxy authentication and optional per-role model overrides.
CRS_OAI_KEY=
CODEX_ONLY_MODEL_DEFAULT=gpt-5.6-luna
CODEX_ONLY_MODEL_GAME_PLANNER=
CODEX_ONLY_MODEL_GAMEPLAY_DEVELOPER=
CODEX_ONLY_MODEL_BUG_FIXER=
CODEX_ONLY_MODEL_VISUAL_REVIEWER=
CODEX_ONLY_TIMEOUT_MS=300000
GAMEPLAY_PHASE_TIMEOUT_MS=300000

AI_PROVIDER=auto
GAME_QUALITY=auto
YGG_SDK_ENABLED=true

LOG_LEVEL=debug
FACTORY_HOST_PORT=15173
FACTORY_PROJECTS_DIR=projects
FACTORY_OUTPUT_DIR=output
PUPPETEER_EXECUTABLE_PATH=
